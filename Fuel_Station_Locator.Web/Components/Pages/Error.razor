@page "/Error"
@using System.Diagnostics

<PageTitle>Error - Fuel Station Locator</PageTitle>

<div class="page-shell">
    <header class="app-header">
        <div class="container">
            <h1 class="app-title">Fuel Station Locator</h1>
        </div>
    </header>

    <main class="container py-5">
        <h2 class="h4">Sorry, something went wrong.</h2>
        <p>An error occurred while processing your request. Please try again in a moment.</p>
        @if (!string.IsNullOrEmpty(RequestId))
        {
            <p class="small text-body-secondary">Request ID: <code>@RequestId</code></p>
        }
        <a class="btn btn-primary" href="/">Back to search</a>
    </main>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
